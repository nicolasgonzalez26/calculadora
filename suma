def ejecutar_calculadora():
    print("--- CALCULADORA DE SUMA ---")
    
    while True:
        try:
            # 1. Pedir los números al usuario
            num1 = float(input("\nIngresa el primer número: "))
            num2 = float(input("Ingresa el segundo número: "))
            
            # 2. Hacer la operación y mostrar el resultado
            resultado = num1 + num2
            print(f"👉 El resultado de la suma es: {resultado}")
            
        except ValueError:
            print("❌ Error: Por favor, ingresa solo números válidos.")
            continue
        
        # 3. Preguntar si desea continuar o salir
        salir = input("\n¿Quieres hacer otra suma? (s/n): ").strip().lower()
        if salir != 's':
            print("👋 ¡Hasta luego!")
            break

if __name__ == "__main__":
    ejecutar_calculadora()